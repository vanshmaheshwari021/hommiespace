{
  "name": "hommiespace",
  "version": "1.0.0",
  "private": true,
  "description": "HommieSpace - A MERN Multi-vendor Marketplace for Home Decor & Furniture",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspaces --if-present",
    "install:all": "npm install",
    "seed": "tsx scripts/seed.mts"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
